{
  "manifestVersion": 2,
  "id": "avari-glow-theme",
  "name": "Avari Glow",
  "version": "0.1.1",
  "description": "Avari Glow dark theme inspired by @SIREN.UIX",
  "engines": {
    "orca": ">=1.4.246"
  },
  "execution": "data",
  "contributes": {
    "themes": [
      {
        "id": "avari-glow-theme-dark",
        "title": "Avari Glow",
        "path": "themes/avari-glow.json"
      }
    ],
    "terminalThemes": [
      {
        "id": "avari-glow-terminal",
        "title": "Avari Glow",
        "path": "terminal/avari-glow.json"
      }
    ]
  },
  "repository": "https://github.com/OstKost/avari-glow-orca-theme",
  "homepage": "https://github.com/OstKost/orca-avari-glow-theme",
  "license": "LicenseRef-Avari"
}
